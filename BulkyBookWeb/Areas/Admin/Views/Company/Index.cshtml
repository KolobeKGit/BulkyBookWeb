@model IEnumerable<Company>
@{
    ViewData["Title"] = "Index";
}

<div class="container p-3">
    <div class="row pt-4">
        <div class="col-6">
            <h2 class="text-primary">Company List</h2>
        </div>
        <div class="col-6 text-end">
            <a asp-controller="Company" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> &nbsp; Create new company
            </a>
        </div>
    </div>
    <br />
    <table id="tblCompanyData" class="table table-bordered table-striped" style="width:100%">
        <thead>
            <tr>
                <th>Company Name</th>
                <th>Steet Address</th>
                <th>City</th>
                <th>Province</th>
                <th>Postal Code</th>
                <th>Phone Number</th>
                <th></th>
            </tr>
        </thead>
        
    </table>
</div>

@section Scripts{
    <script src="~/js/company.js"></script>
}